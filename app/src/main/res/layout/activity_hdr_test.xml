<?xml version="1.0" encoding="utf-8"?>
<!-- The fields own the whole screen; the controls are a small card in a corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hdrRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/hdrSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.limelight.RatioPlotView
        android:id="@+id/hdrRatioPlot"
        android:layout_width="260dp"
        android:layout_height="140dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="#B3000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hdrPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card"
        android:minWidth="188dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/hdrInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/hdrQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/hdr_test_question"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hdrValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/hdrAnswers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hdrAnswerDimmer"
                android:layout_width="86dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/hdr_test_answer_dimmer"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hdrAnswerSame"
                android:layout_width="86dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_answer_same"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hdrProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#73FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hdrModePeak"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/hdr_test_mode_peak"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hdrModeGlobal"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_mode_global"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hdrModeBlack"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_mode_black"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hdrSlot"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_slot"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hdrSave"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_save"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hdrClose"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/hdr_test_close"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
